msgstr "Контрольна сума файлу документа"

msgid "Document label"
msgstr "Мітка документа"

msgid "Document removed from cabinet"
msgstr "Документ вилучено з комірки"

msgid "Document type"
msgstr "Тип документа"

msgid "Documents"
msgstr "Документи"

msgid "Documents URL"
msgstr "URL-адреса документів"

msgid "Documents can be added to many cabinets."
msgstr "Документи можна додавати до багатьох комірк."

msgid "Edit"
msgstr "Редагувати"

msgid "Edit cabinet: %s"
msgstr "Редагувати комірку: %s"

msgid "Edit cabinets"
msgstr "Редагувати комірки"

msgid "Full path"
msgstr "Повний шлях"

msgid "Label"
msgstr "Мітка"


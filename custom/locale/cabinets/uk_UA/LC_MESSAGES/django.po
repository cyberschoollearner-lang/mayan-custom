msgstr "%(count)d документи успішно додано до комірок."

msgid "%(count)d documents removed from cabinets successfully."
msgstr "%(count)d документи успішно видалено з комірок."

msgid "%(model_name)s with this %(field_labels)s already exists."
msgstr "%(model_name)sз цим %(field_labels)s уже існує."

msgid "A short text used to identify the cabinet."
msgstr "Короткий текст, який використовується для ідентифікації комірки."

msgid "Add %(count)d document to cabinets."
msgstr "Додайте документ %(count)d до комірок."

msgid "Add %(count)d documents to cabinets."
msgstr "Додати документи %(count)d до комірок."

msgid "Add document \"%(object)s\" to cabinets."
msgstr "Додайте документ \"%(object)s\" до комірок."

msgid "Add documents to cabinets"
msgstr "Додати документи до комірок"

msgid "Add new level"
msgstr "Додати новий рівень"

msgid "Add new level to: %s"
msgstr "Додати новий рівень до: %s"

msgid "Add to cabinets"
msgstr "Додати до комірок"

msgid "All"
msgstr "Все"

msgid "Cabinet"
msgstr "Комірка"

msgid "Cabinet created"
msgstr "Комірку створено"

msgid "Cabinet deleted"
msgstr "Комірку видалено"

msgid "Cabinet edited"
msgstr "Комірку відредаговано"

msgid ""
"Cabinet levels can contain documents or other cabinet sub levels. To add "
"documents to a cabinet, select the cabinet view of a document view."
msgstr ""
"Рівні кабінету можуть містити документи або інші підрівні кабінету. Щоб "
"додати документи до кабінету, виберіть режим перегляду документа."

msgid "Cabinets"
msgstr "Комірки"

msgid ""
"Cabinets are a multi-level method to organize documents. Each cabinet can "
"contain documents as well as other sub level cabinets."
msgstr ""
"Комірки – це багаторівневий спосіб організації документів. Кожна комірка може "
"містити документи, а також інші комірки підрівня."

msgid "Cabinets containing document: %s"
msgstr "Комірки, що містять документ: %s"

msgid "Cabinets from which the document will be removed"
msgstr "Комірки, з яких буде вилучено документ"

msgid "Cabinets from which the selected documents will be removed."
msgstr "Комірки, з яких будуть вилучені вибрані документи."

msgid "Cabinets to which the document will be added."
msgstr "Комірки, до яких буде додано документ."

msgid "Cabinets to which the selected documents will be added."
msgstr "Комірки, до яких будуть додані вибрані документи."

msgid "Children"
msgstr "Дитина"

msgid "Create cabinet"
msgstr "Створити комірку"

msgid "Create cabinets"
msgstr "Створити комірки"


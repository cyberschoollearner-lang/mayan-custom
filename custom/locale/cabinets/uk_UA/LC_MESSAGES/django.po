msgstr "Батьківський URL"

msgid "Primary key of the document to add to the cabinet."
msgstr ""
"Первинний ключ \"Primary key\" документа, який потрібно додати до комірки."

msgid "Primary key of the document to remove from the cabinet."
msgstr "Первинний ключ \"Primary key\" документа для вилучення з комірки."

msgid "Remove %(count)d document from cabinets."
msgstr "Вилучити документ %(count)d із комірок."

msgid "Remove %(count)d documents from cabinets."
msgstr "Видалити %(count)d документів із комірок."

msgid "Remove document \"%(object)s\" from cabinets."
msgstr "Видалити документ \"%(object)s\" із комірк."

msgid "Remove documents from cabinets"
msgstr "Видалити документи з комірк"

msgid "Remove from cabinets"
msgstr "Вилучити з комірки"

msgid "Return a list of cabinets containing the document."
msgstr "Повернути список комірок, що містять документ."

msgid "Select cabinets"
msgstr "Оберіть комірки"

msgid "The name of this cabinet level appended to the names of its ancestors."
msgstr "Назва цього рівня кабінету додалася до імен його предків."

msgid "The path to the cabinet including all ancestors."
msgstr "Шлях до комірки, включаючи всіх предків."

msgid "This cabinet level is empty"
msgstr "Цей рівень кабінету порожній"

msgid "This document is not in any cabinet"
msgstr "Цього документа немає ні в одній коміркі"

msgid "URL"
msgstr "URL"

msgid "URL of the API endpoint showing the list documents inside this cabinet."
msgstr ""
"URL кінцевої точки API, що показує список документів всередині цього "
"кабінету."

msgid "View cabinets"
msgstr "Переглянути комірки"

